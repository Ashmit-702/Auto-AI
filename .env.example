# --- Upstash Redis (free tier, REST API) ---
# Create at https://console.upstash.com -> Redis -> Create Database -> REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Gemini (free tier via AI Studio) ---
# Create key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Internal tick endpoint protection ---
# Any random string. Used as: Authorization: Bearer <TICK_SECRET>
TICK_SECRET=

# --- Publishing cadence ---
# Minimum minutes between two published posts for the same agent.
MIN_POST_GAP_MINUTES=90
